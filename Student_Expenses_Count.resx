  <metadata name="sqlDataSource1.ParameterValues" xml:space="preserve">
    <value>{"@SchoolyearID":"2025","@SchoolID":"4","@GradeID":"14","@ExpenseID":"1"}</value>
  </metadata>
  <data name="sqlDataSource1.SelectCommand" xml:space="preserve">
    <value>select *,1 as Paied from [dbo].[Vw_Subscription] 
where TotalPaied &lt;&gt; 0 and  TotalPaied &lt;&gt; CurrentExpensesCost
AND (SchoolYearID = @SchoolyearID) 
AND (SchoolID = @SchoolID or @SchoolID Is NULL) 
AND (GradeID = @GradeID OR @GradeID IS NULL)
AND (ExpensesID = @ExpenseID) 
AND (StudentStatusID IN (1, 2))

union all 


select *,2 as Paied from [dbo].[Vw_Subscription] 
where TotalPaied = 0 
AND (SchoolYearID = @SchoolyearID) 
AND (SchoolID = @SchoolID  or @SchoolID Is NULL) 
AND (GradeID = @GradeID OR @GradeID IS NULL)
AND (ExpensesID = @ExpenseID) 


union all


select *,3 as Paied from [dbo].[Vw_Subscription] 
where TotalPaied = CurrentExpensesCost
AND (SchoolYearID = @SchoolyearID) 
AND (SchoolID = @SchoolID  or @SchoolID Is NULL) 
AND (GradeID = @GradeID OR @GradeID IS NULL)
AND (ExpensesID = @ExpenseID) 
AND (StudentStatusID IN (1, 2))</value>
  </data>
