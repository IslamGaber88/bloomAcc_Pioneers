  <metadata name="sqlDataSource1.ParameterValues" xml:space="preserve">
    <value>{"@AccountID":"NULL","@DateFrom":"2000-01-01","@DateTo":"2026-01-01","@SchoolID":"10"}</value>
  </metadata>
  <data name="sqlDataSource1.SelectCommand" xml:space="preserve">
    <value> 
SELECT 
    ROW_NUMBER() OVER (ORDER BY AC.AccountName) AS ID,
    AC.AccountId AS AccountID,
    AC.AccountName AS AccountName,
    SC.SchoolTitle AS SchoolTitle,
    
    -- Initial Debit Balance
    ISNULL((SELECT SUM(Amount) 
            FROM dbo.sch_Payment SP1 
            WHERE SP1.AccountID = AC.AccountId 
            AND CAST(SP1.CreatedDateTime AS DATE) &lt; CAST(@DateFrom AS DATE)
            AND SP1.IsDeleted = 0 
            AND SP1.IsCashIN = 0
            AND SP1.SchoolID = @SchoolID), 0) AS Initial_Debit,
    
    -- Initial Credit Balance
    ISNULL((SELECT SUM(Amount) 
            FROM dbo.sch_Payment SP2 
            WHERE SP2.AccountID = AC.AccountId 
            AND CAST(SP2.CreatedDateTime AS DATE) &lt; CAST(@DateFrom AS DATE)
            AND SP2.IsDeleted = 0 
            AND SP2.IsCashIN = 1
            AND SP2.SchoolID = @SchoolID), 0) AS Initial_Credit,
    
    -- Period Debit Movement
    ISNULL((SELECT SUM(Amount) 
            FROM dbo.sch_Payment SP3 
            WHERE SP3.AccountID = AC.AccountId 
            AND CAST(SP3.CreatedDateTime AS DATE) &gt;= CAST(@DateFrom AS DATE)
            AND CAST(SP3.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE)
            AND SP3.IsDeleted = 0 
            AND SP3.IsCashIN = 0
            AND SP3.SchoolID = @SchoolID), 0) AS Period_Debit,
    
    -- Period Credit Movement
    ISNULL((SELECT SUM(Amount) 
            FROM dbo.sch_Payment SP4 
            WHERE SP4.AccountID = AC.AccountId 
            AND CAST(SP4.CreatedDateTime AS DATE) &gt;= CAST(@DateFrom AS DATE)
            AND CAST(SP4.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE)
            AND SP4.IsDeleted = 0 
            AND SP4.IsCashIN = 1
            AND SP4.SchoolID = @SchoolID), 0) AS Period_Credit,
    
    -- Total Debit
    (ISNULL((SELECT SUM(Amount) 
             FROM dbo.sch_Payment SP5 
             WHERE SP5.AccountID = AC.AccountId 
             AND CAST(SP5.CreatedDateTime AS DATE) &lt; CAST(@DateFrom AS DATE)
             AND SP5.IsDeleted = 0 
             AND SP5.IsCashIN = 0
             AND SP5.SchoolID = @SchoolID), 0) +
     ISNULL((SELECT SUM(Amount) 
             FROM dbo.sch_Payment SP6 
             WHERE SP6.AccountID = AC.AccountId 
             AND CAST(SP6.CreatedDateTime AS DATE) &gt;= CAST(@DateFrom AS DATE)
             AND CAST(SP6.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE)
             AND SP6.IsDeleted = 0 
             AND SP6.IsCashIN = 0
             AND SP6.SchoolID = @SchoolID), 0)) AS Total_Debit,
    
    -- Total Credit
    (ISNULL((SELECT SUM(Amount) 
             FROM dbo.sch_Payment SP7 
             WHERE SP7.AccountID = AC.AccountId 
             AND CAST(SP7.CreatedDateTime AS DATE) &lt; CAST(@DateFrom AS DATE)
             AND SP7.IsDeleted = 0 
             AND SP7.IsCashIN = 1
             AND SP7.SchoolID = @SchoolID), 0) +
     ISNULL((SELECT SUM(Amount) 
             FROM dbo.sch_Payment SP8 
             WHERE SP8.AccountID = AC.AccountId 
             AND CAST(SP8.CreatedDateTime AS DATE) &gt;= CAST(@DateFrom AS DATE)
             AND CAST(SP8.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE)
             AND SP8.IsDeleted = 0 
             AND SP8.IsCashIN = 1
             AND SP8.SchoolID = @SchoolID), 0)) AS Total_Credit,
    
    -- End Balance Debit
    CASE 
        WHEN ((ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP9 WHERE SP9.AccountID = AC.AccountId AND CAST(SP9.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP9.IsDeleted = 0 AND SP9.IsCashIN = 0 AND SP9.SchoolID = @SchoolID), 0)) -
              (ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP10 WHERE SP10.AccountID = AC.AccountId AND CAST(SP10.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP10.IsDeleted = 0 AND SP10.IsCashIN = 1 AND SP10.SchoolID = @SchoolID), 0))) &gt; 0 
        THEN ((ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP11 WHERE SP11.AccountID = AC.AccountId AND CAST(SP11.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP11.IsDeleted = 0 AND SP11.IsCashIN = 0 AND SP11.SchoolID = @SchoolID), 0)) -
              (ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP12 WHERE SP12.AccountID = AC.AccountId AND CAST(SP12.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP12.IsDeleted = 0 AND SP12.IsCashIN = 1 AND SP12.SchoolID = @SchoolID), 0)))
        ELSE 0 
    END AS End_Balance_Debit,
    
    -- End Balance Credit
    CASE 
        WHEN ((ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP13 WHERE SP13.AccountID = AC.AccountId AND CAST(SP13.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP13.IsDeleted = 0 AND SP13.IsCashIN = 1 AND SP13.SchoolID = @SchoolID), 0)) -
              (ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP14 WHERE SP14.AccountID = AC.AccountId AND CAST(SP14.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP14.IsDeleted = 0 AND SP14.IsCashIN = 0 AND SP14.SchoolID = @SchoolID), 0))) &gt; 0 
        THEN ((ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP15 WHERE SP15.AccountID = AC.AccountId AND CAST(SP15.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP15.IsDeleted = 0 AND SP15.IsCashIN = 1 AND SP15.SchoolID = @SchoolID), 0)) -
              (ISNULL((SELECT SUM(Amount) FROM dbo.sch_Payment SP16 WHERE SP16.AccountID = AC.AccountId AND CAST(SP16.CreatedDateTime AS DATE) &lt;= CAST(@DateTo AS DATE) AND SP16.IsDeleted = 0 AND SP16.IsCashIN = 0 AND SP16.SchoolID = @SchoolID), 0)))
        ELSE 0 
    END AS End_Balance_Credit

FROM dbo.AccountingChart AC
INNER JOIN dbo.sch_School SC ON SC.SchoolID = @SchoolID
WHERE  
  EXISTS (SELECT 1 FROM dbo.sch_Payment SP 
            WHERE SP.AccountID = AC.AccountId 
            AND SP.SchoolID = @SchoolID 
            AND SP.IsDeleted = 0)
AND (@AccountID IS NULL OR AC.AccountId = @AccountID)
ORDER BY AC.AccountId</value>
  </data>
