  <data name="sqlDataSource1.SelectCommand" xml:space="preserve">
    <value>--declare @DateFrom date = '2024-01-01'
--declare @DateTo date = '2025-01-01'
--declare @SchoolID int = null 
--declare @Schoolyear int = 2024
--declare @LineID int = null 




SELECT        Vw_BusSubscription.DiscountTitle, Vw_BusSubscription.Value, Vw_BusSubscription.BusSubscriptionID, Vw_BusSubscription.SchoolID, Vw_BusSubscription.SchoolYearID, Vw_BusSubscription.StudentID, 
                         Vw_BusSubscription.BusLineID, Vw_BusSubscription.DistanceCost, Vw_BusSubscription.CreatedDate, Vw_BusSubscription.IsDeleted, Vw_BusSubscription.LineTitle, Vw_BusSubscription.DiscountID, 
                         Vw_BusSubscription.TotalDiscount, Vw_BusSubscription.ExpensesCostAfterDiscount, Vw_BusSubscription.TotalPaied, sch_Student.StudentStatusID, sch_School.SchoolTitle, sch_Student.Stu_FirstName, 
                         sch_Student.Stu_MiddleName, sch_Student.Stu_LastName
FROM            Vw_BusSubscription INNER JOIN
                         sch_Student ON Vw_BusSubscription.StudentID = sch_Student.StudentID INNER JOIN
                         sch_School ON Vw_BusSubscription.SchoolID = sch_School.SchoolID
where 
     (dbo.[Vw_BusSubscription].SchoolID=@SchoolID or @SchoolID IS NULL) and (dbo.[Vw_BusSubscription].SchoolYearID=@Schoolyear)  and 
     ([Vw_BusSubscription].BusLineID=@LineID or @LineID Is NULL) and ([Vw_BusSubscription].TotalPaied &lt;&gt;0) </value>
  </data>
